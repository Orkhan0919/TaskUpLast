<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TaskUp</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/theme.css" />
    
    <style>
        * {
        font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-gray-950 text-gray-100 antialiased min-h-screen flex flex-col">

    <nav class="bg-gray-900 border-b border-gray-800 px-6 py-3">
        <div class="container mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-r from-blue-500 to-blue-700 flex items-center justify-center">
                    <i class="fas fa-tasks text-white text-sm"></i>
                </div>
                <a href="/" class="text-xl font-bold text-white hover:text-blue-400 transition">TaskUp</a>
            </div>
            <div class="flex items-center space-x-4">
                <partial name="_ThemeSwitcher" />
                @if (User.Identity.IsAuthenticated)
                {
                    <span class="text-sm text-gray-400">@User.Identity.Name</span>
                }
            </div>
        </div>
    </nav>

    <main class="flex-grow">
        @RenderBody()
    </main>
    
    <script src="~/js/theme.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>