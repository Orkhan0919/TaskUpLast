@model int 

<!-- Chat Sidebar -->
<div id="chatSidebar" class="w-80 bg-gray-900 border-l border-gray-800 flex flex-col hidden">
    <div class="p-4 border-b border-gray-800 flex items-center justify-between">
        <h3 class="font-semibold text-white flex items-center">
            <i class="fas fa-comments text-blue-400 mr-2"></i>
            Team Chat
        </h3>
        <button id="closeChatBtn" class="text-gray-400 hover:text-white">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <div id="chatMessages" class="flex-1 overflow-y-auto p-4 space-y-4">
        <!-- Mesajlar buraya gelecek -->
    </div>

    <div class="p-4 border-t border-gray-800">
        <!-- Dosya önizleme alanı -->
        <div id="filePreviewContainer" class="hidden">
            <div class="flex flex-wrap gap-2"></div>
        </div>

        <!-- Mesaj formu -->
        <form id="chatForm" class="w-full">
            @Html.AntiForgeryToken()
            <input type="hidden" id="boardId" value="@Model" />

            <div class="message-input-container">
                <input type="text"
                       id="chatMessageInput"
                       class="w-full bg-gray-800 border border-gray-700 rounded-xl py-3 px-4 pr-20 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
                       placeholder="Type a message...">

                <!-- Dosya yükleme butonu (SOLDAN SAĞA TAŞINDI) -->
                <label for="fileInput" class="file-upload-btn">
                    <i class="fas fa-paperclip text-gray-400 hover:text-white text-xl"></i>
                </label>

                <input type="file"
                       id="fileInput"
                       class="hidden"
                       multiple
                       accept=".jpg,.jpeg,.png,.gif,.pdf,.doc,.docx,.txt,.zip">

                <button type="submit" class="send-btn">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>

            <p class="text-xs text-gray-500 mt-2">
                <i class="fas fa-info-circle mr-1"></i>
                Max 20MB per file (Images, PDF, DOC, TXT, ZIP)
            </p>
        </form>
    </div>
</div>