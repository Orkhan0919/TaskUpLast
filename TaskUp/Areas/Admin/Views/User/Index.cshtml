@model List<TaskUp.ViewModels.Admin.UserWithRoleVM>
@{
    ViewData["Title"] = "User Management";
    Layout = "_AdminLayout";
}

<!-- GİZLİ TOKEN INPUT'U - BURASI EKLENDİ -->
@Html.AntiForgeryToken()

<div class="container-fluid py-4">
    <h1 class="text-2xl font-bold text-white mb-6">User Management</h1>

    <div class="mb-4 p-4 bg-gray-900 rounded-xl border border-gray-800">
        <p class="text-gray-400">Total Users: <span class="text-white font-bold">@Model.Count</span></p>
    </div>

    <div class="bg-gray-900 rounded-2xl p-6 border border-gray-800">
        <table class="w-full">
            <thead>
            <tr class="text-left text-gray-400 border-b border-gray-800">
                <th class="pb-3">Email</th>
                <th class="pb-3">Username</th>
                <th class="pb-3">Display Name</th>
                <th class="pb-3">Status</th>
                <th class="pb-3">Roles</th>
                <th class="pb-3">Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var user in Model)
            {
            <tr class="border-b border-gray-800">
                <td class="py-3 text-white">@user.Email</td>
                <td class="py-3 text-white">@user.UserName</td>
                <td class="py-3 text-white">@(user.DisplayName ?? "-")</td>
                <td class="py-3">
                    @if (user.EmailConfirmed)
                    {
                    <span class="px-2 py-1 bg-green-900/30 text-green-400 rounded-full text-xs">Confirmed</span>
                    }
                    else
                    {
                    <span class="px-2 py-1 bg-yellow-900/30 text-yellow-400 rounded-full text-xs">Pending</span>
                    }
                </td>
                <td class="py-3">
                    @foreach (var role in user.Roles)
                    {
                    <span class="px-2 py-1 bg-blue-900/30 text-blue-400 rounded-full text-xs mr-1">
                                    @role
                                </span>
                    }
                </td>
                <td class="py-3">
                    @if (user.Roles.Contains("Admin"))
                    {
                    <button onclick="removeAdmin('@user.UserId')"
                            class="px-3 py-1 bg-red-600 hover:bg-red-700 rounded-lg text-white text-sm">
                        Remove Admin
                    </button>
                    }
                    else
                    {
                    <button onclick="makeAdmin('@user.UserId')"
                            class="px-3 py-1 bg-green-600 hover:bg-green-700 rounded-lg text-white text-sm">
                        Make Admin
                    </button>
                    }
                </td>
            </tr>
            }
            </tbody>
        </table>

        @if (!Model.Any())
        {
        <div class="text-center py-8 text-gray-400">
            No users found in database.
        </div>
        }
    </div>
</div>

@section Scripts {
<script>
    function makeAdmin(userId) {
        if (confirm('Make this user admin?')) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            if (!token) {
                alert('Security token not found! Please refresh the page.');
                return;
            }

            fetch('/Admin/User/MakeAdmin', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ userId: userId })
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Failed: ' + (data.message || 'Unknown error'));
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Network error occurred');
                });
        }
    }

    function removeAdmin(userId) {
        if (confirm('Remove admin privileges?')) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            if (!token) {
                alert('Security token not found! Please refresh the page.');
                return;
            }

            fetch('/Admin/User/RemoveAdmin', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ userId: userId })
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Failed: ' + (data.message || 'Unknown error'));
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Network error occurred');
                });
        }
    }
</script>
}