<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TaskUp Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-950 text-white">
<div class="flex h-screen">
    <!-- Sidebar -->
    <aside class="w-64 bg-gray-900 border-r border-gray-800">
        <div class="p-6">
            <h1 class="text-xl font-bold text-white">TaskUp Admin</h1>
        </div>
        <nav class="mt-6">
            <a href="/Admin/Home/Index" 
               class="flex items-center px-6 py-3 text-gray-400 hover:text-white hover:bg-gray-800 transition-colors">
                <i class="fas fa-chart-pie w-5 mr-3"></i>
                Dashboard
            </a>
            <a href="/Admin/User/Index" 
               class="flex items-center px-6 py-3 text-gray-400 hover:text-white hover:bg-gray-800 transition-colors">
                <i class="fas fa-users w-5 mr-3"></i>
                Users
            </a>
            <a href="/Admin/Board/Index" 
               class="flex items-center px-6 py-3 text-gray-400 hover:text-white hover:bg-gray-800 transition-colors">
                <i class="fas fa-columns w-5 mr-3"></i>
                Boards
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 overflow-y-auto p-8">
        @RenderBody()
    </main>
</div>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>